# Opcional: clave propia de navegador, restringida por dominio, con Maps JavaScript API.
# NEXT_PUBLIC_RADAR_MAPS_KEY=clave_de_navegador_restringida
# NEXT_PUBLIC_APP_URL=http://localhost:5173
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/radarlocal_dev
# BETTER_AUTH_SECRET=generar_un_valor_aleatorio_de_al_menos_32_bytes
# BETTER_AUTH_URL=http://localhost:5173
# RESEND_API_KEY=clave_del_proveedor_de_correo
# EMAIL_FROM=correo_verificado_del_proveedor
# RADAR_HYPERDRIVE_ID=id_de_hyperdrive_solo_para_build_de_cloudflare
# RADAR_R2_BUCKET_NAME=nombre_del_bucket_privado_solo_para_build_de_cloudflare

# Build aislado de staging: estos identificadores no son secretos y nunca deben
# coincidir con recursos de producción. RADAR_DEPLOY_ENV no va en el Worker.
# RADAR_DEPLOY_ENV=staging
# RADAR_STAGING_HYPERDRIVE_ID=id_del_hyperdrive_de_staging_sin_cache
# RADAR_STAGING_R2_BUCKET_NAME=nombre_del_bucket_privado_de_staging
# En el runtime de staging, configure BETTER_AUTH_URL y secretos propios.
