# Para mostrar el mapa, usa una Maps Demo Key o una clave con
# Maps JavaScript API y Places API (New) habilitadas.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_clave_de_demostracion
# NEXT_PUBLIC_APP_URL=http://localhost:5173
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/radarlocal_dev
# BETTER_AUTH_SECRET=generar_un_valor_aleatorio_de_al_menos_32_bytes
# BETTER_AUTH_URL=http://localhost:5173
# RESEND_API_KEY=clave_del_proveedor_de_correo
# EMAIL_FROM=correo_verificado_del_proveedor
# RADAR_HYPERDRIVE_ID=id_de_hyperdrive_solo_para_build_de_cloudflare
